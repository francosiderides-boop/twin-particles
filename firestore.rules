rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function members(cid) { return get(/databases/$(db)/documents/couples/$(cid)).data.members; }
    match /couples/{cid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (resource.data.members.size() < 2
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])));
      match /msgs/{m} {
        allow read, delete: if request.auth != null && request.auth.uid in members(cid);
        allow create: if request.auth != null && request.auth.uid in members(cid)
          && request.resource.data.from == request.auth.uid;
      }
    }
  }
}
